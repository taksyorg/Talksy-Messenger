    <string name="bot_docs_label">ЯК ПІДКЛЮЧИТИ СВОГО БОТА</string>
    <string name="bot_docs_intro">Код бота написаний на Python і виконується НА ВАШОМУ ВЛАСНОМУ МАШИНІ, а не в месенджері. Ось мінімальний робочий приклад використання getUpdates:</string>
    <string name="bot_docs_code_sample"><![CDATA[import requests, time

TOKEN = "%1$s"
BASE = "SERVER/bot" + TOKEN

offset = 0
while True:
    r = requests.get(f"{BASE}/getUpdates", params={"offset": offset, "timeout": 25}).json()
    for upd in r["result"]:
        offset = upd["update_id"] + 1
        msg = upd["message"]
        chat_id = msg["chat"]["id"]
        text = msg["text"]
        requests.post(f"{BASE}/sendMessage",
            json={"chat_id": chat_id, "text": f"You said: {text}"})]]></string>

