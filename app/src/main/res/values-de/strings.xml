    <string name="bot_docs_label">SO VERBINDEN SIE IHREN BOT</string>
    <string name="bot_docs_intro">Der Bot-Code ist in Python geschrieben und läuft AUF IHRER EIGENEN MASCHINE – nicht im Messenger. Hier ist ein minimales Arbeitsbeispiel mit getUpdates:</string>
    <string name="bot_docs_code_sample"><![CDATA[import requests, time

TOKEN = "%1$s"
BASE = "SERVER/bot" + TOKEN

offset = 0
while True:
    r = requests.get(f"{BASE}/getUpdates", params={"offset": offset, "timeout": 25}).json()
    for upd in r["result"]:
        offset = upd["update_id"] + 1
        msg = upd["message"]
        chat_id = msg["chat"]["id"]
        text = msg["text"]
        requests.post(f"{BASE}/sendMessage",
            json={"chat_id": chat_id, "text": f"You said: {text}"})]]></string>

