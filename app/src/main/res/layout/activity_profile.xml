<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:background="@color/bg2"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/ripple_item_round"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/profile"
            android:textColor="@color/text1"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/profile_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <FrameLayout
                android:id="@+id/frame_avatar"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/txt_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/img_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/txt_change_photo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Изменить фото"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                style="@style/SettingsSectionHeader"
                android:text="ПРОФИЛЬ" />

            <LinearLayout style="@style/SettingsCard" android:orientation="vertical" android:padding="14dp">

                <TextView style="@style/TalksyLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_name" />
                <EditText android:id="@+id/inp_name" style="@style/TalksyInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" />

                <TextView style="@style/TalksyLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/profile_handle" />
                <EditText android:id="@+id/inp_handle" style="@style/TalksyInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" />

                <TextView style="@style/TalksyLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/profile_bio" />
                <EditText android:id="@+id/inp_bio" style="@style/TalksyInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:minLines="2" android:singleLine="false" />
            </LinearLayout>

            <TextView
                style="@style/SettingsSectionHeader"
                android:text="КОНТАКТЫ" />

            <LinearLayout style="@style/SettingsCard">

                <LinearLayout style="@style/SettingsRow" android:id="@+id/row_phone" android:clickable="true" android:focusable="true" android:background="@drawable/ripple_item">
                    <ImageView style="@style/SettingsRowIcon" android:padding="7dp" android:src="@drawable/ic_tk_call_confirm" android:tint="@color/tk_icon" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/TalksyLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_phone" />
                        <TextView android:id="@+id/txt_phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/text1" android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout style="@style/SettingsRow">
                    <ImageView style="@style/SettingsRowIcon" android:padding="7dp" android:src="@drawable/ic_tk_mention" android:tint="@color/tk_icon" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/TalksyLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_email" />
                        <TextView android:id="@+id/txt_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/text1" android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/SettingsCard" android:visibility="gone">

                <LinearLayout style="@style/SettingsRow">
                    <ImageView style="@style/SettingsRowIcon" android:padding="7dp" android:src="@drawable/ic_tk_hide" android:tint="@color/tk_icon" />
                    <TextView style="@style/SettingsRowTitle" android:text="Скрыть номер телефона от других" />
                    <Switch android:id="@+id/switch_hide_phone" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout style="@style/SettingsRow">
                    <ImageView style="@style/SettingsRowIcon" android:padding="7dp" android:src="@drawable/ic_tk_hide" android:tint="@color/tk_icon" />
                    <TextView style="@style/SettingsRowTitle" android:text="Скрыть @username от других" />
                    <Switch android:id="@+id/switch_hide_handle" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout style="@style/SettingsRow">
                    <ImageView style="@style/SettingsRowIcon" android:padding="7dp" android:src="@drawable/ic_tk_history" android:tint="@color/tk_icon" />
                    <TextView style="@style/SettingsRowTitle" android:text="Скрыть точное время захода" />
                    <Switch android:id="@+id/switch_hide_last_seen" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/SettingsCard" android:orientation="vertical" android:padding="14dp" android:layout_marginTop="14dp">
                <Button android:id="@+id/btn_save" style="@style/TalksyButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_logout"
                style="@style/SettingsCard"
                android:layout_marginTop="14dp">

                <LinearLayout
                    style="@style/SettingsRow"
                    android:id="@+id/btn_logout_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/ripple_item">
                    <ImageView style="@style/SettingsRowIcon" android:padding="7dp" android:src="@drawable/ic_tk_logout" android:tint="@color/tk_icon" />
                    <TextView
                        android:id="@+id/btn_logout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/logout"
                        android:textColor="@color/err"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
