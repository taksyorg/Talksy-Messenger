<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Создайте профиль"
                android:textColor="@color/text1"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="18dp"
                android:text="Добавьте имя и выберите цвет аватара — это увидят другие пользователи"
                android:textColor="@color/text2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txt_avatar_preview"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inp_first_name"
                style="@style/TalksyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Имя"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/inp_last_name"
                style="@style/TalksyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Фамилия (необязательно)"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/inp_username"
                style="@style/TalksyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Username (необязательно)"
                android:inputType="textNoSuggestions"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txt_username_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <TextView
                style="@style/TalksyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ЦВЕТ АВАТАРА"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/color_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="18dp" />

            <TextView
                android:id="@+id/txt_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="Введите имя"
                android:textColor="@color/err"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_finish"
                style="@style/TalksyButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Готово" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
