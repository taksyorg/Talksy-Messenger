<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="14dp"
        android:background="@color/bg2">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/ripple_item_round"
            android:src="@drawable/ic_back" />

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp">

            <TextView
                android:id="@+id/txt_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/img_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txt_last_seen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text2"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_video_call"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/ripple_item_round"
            android:src="@drawable/ic_video" />

        <ImageButton
            android:id="@+id/btn_call"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/ripple_item_round"
            android:src="@drawable/ic_call" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border1" />

    <LinearLayout
        android:id="@+id/pin_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@color/bg2"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pinned_title"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_pin_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text1"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border1" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:id="@+id/reply_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@color/bg2"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_reply_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_reply_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text2"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_reply_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text=""
        android:foreground="@drawable/ic_tk_fg_close"
        android:foregroundGravity="center"
        android:foregroundTint="@color/tk_icon"
            android:textColor="@color/text2"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bar_bot_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="@color/bg2"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_bot_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_gradient"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/bot_start"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bar_blocked"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="14dp"
        android:background="@color/bg2"
        android:visibility="gone">

        <TextView
            android:id="@+id/txt_blocked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/blocked_by_peer"
            android:textColor="@color/text2"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/input_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="@color/bg2">

        <ImageButton
            android:id="@+id/btn_attach"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ripple_item_round"
            android:src="@drawable/ic_attach"
            android:contentDescription="Прикрепить" />

        <ImageButton
            android:id="@+id/btn_mini_app"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ripple_item_round"
            android:src="@drawable/ic_tk_mini_app"
            android:tint="@color/tk_icon"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@string/open_bot_mini_app" />

        <ImageButton
            android:id="@+id/btn_bot_menu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ripple_item_round"
            android:src="@drawable/ic_bot_keyboard"
            android:tint="@color/tk_icon"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@string/bot_menu_toggle" />

        <EditText
            android:id="@+id/inp_message"
            style="@style/TalksyInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/message_hint"
            android:maxLines="4"
            android:singleLine="false" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_record"
            android:src="@drawable/ic_send"
            android:visibility="gone"
            android:contentDescription="@string/send" />

        <ImageButton
            android:id="@+id/btn_record"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_record"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/record_voice" />

        <ImageButton
            android:id="@+id/btn_lock_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_record"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@string/send" />

        <ImageButton
        android:id="@+id/btn_sticker"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_tk_sticker"
        android:tint="@color/tk_icon"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

</LinearLayout>
    <LinearLayout
        android:id="@+id/container_bot_keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@color/bg2"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/sticker_panel_container"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@color/bg2"
        android:visibility="gone" />
</LinearLayout>
