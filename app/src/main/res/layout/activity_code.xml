<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_code_title"
                android:textColor="@color/text1"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_sub1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txt_sub2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:textColor="@color/text2"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/inp_code"
                style="@style/TalksyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/auth_code_hint"
                android:inputType="number"
                android:maxLength="6"
                android:letterSpacing="0.3"
                android:gravity="center" />

            <TextView
                android:id="@+id/txt_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/auth_code_error"
                android:textColor="@color/err"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txt_dev_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/warn"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_verify"
                style="@style/TalksyButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/auth_code_verify" />

            <TextView
                android:id="@+id/btn_resend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/auth_code_resend"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:padding="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/email_spam_hint"
                android:textColor="@color/text3"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
