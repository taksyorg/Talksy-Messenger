<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Talksy" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent2</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent3</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text1</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="alertDialogTheme">@style/MaterialAlertDialog.App</item>
        <item name="materialAlertDialogTheme">@style/MaterialAlertDialog.App</item>
        <item name="android:windowAnimationStyle">@style/Talksy.Dialog.WindowAnimation</item>
    </style>

    <style name="Theme.Talksy.Splash">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
    </style>

    <style name="TalksyInput">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/text1</item>
        <item name="android:textColorHint">@color/text3</item>
        <item name="android:textSize">15sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="TalksyButton">
        <item name="android:background">@drawable/bg_btn_gradient</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">14dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="TalksyLabel">
        <item name="android:textColor">@color/text2</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
</resources>
